{
  "version": 1,
  "settings": {
    "pollIntervalSeconds": 2,
    "historySamples": 60,
    "logBufferLines": 2000,
    "notifications": { "unhealthy": true, "crashed": true, "recovered": true },
    "proxy": { "enabled": true, "listenHost": "127.0.0.1", "httpPort": 8088, "httpsPort": 8448 }
  },
  "projects": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "name": "MyApp",
      "description": "Frontend, API, PostgreSQL and worker example",
      "icon": "󰆍",
      "color": "#7AA2F7",
      "order": 0,
      "services": [
        {
          "id": "22222222-2222-4222-8222-222222222222",
          "name": "PostgreSQL",
          "description": "Compose-managed development database",
          "command": { "executable": "", "arguments": [] },
          "environment": { "POSTGRES_PASSWORD": { "value": "change-me-before-use", "secret": true } },
          "autostart": true,
          "restart": { "mode": "on-failure", "delaySeconds": 2, "maxAttempts": 5, "resetAfterSeconds": 60 },
          "stopSignal": "SIGTERM",
          "gracefulStopSeconds": 20,
          "dependencies": [],
          "docker": { "composeFile": "/home/example/projects/myapp/compose.yaml", "projectName": "myapp", "service": "postgres" },
          "health": { "type": "tcp", "intervalSeconds": 5, "timeoutSeconds": 2, "retries": 5, "startGraceSeconds": 5, "tcp": { "host": "127.0.0.1", "port": 5432 } },
          "notes": "Replace /home/example paths and the sample password before importing."
        },
        {
          "id": "33333333-3333-4333-8333-333333333333",
          "name": "API",
          "description": "Python API on port 8000",
          "command": { "executable": "/usr/bin/python", "arguments": ["-m", "uvicorn", "app.main:app", "--host", "127.0.0.1", "--port", "8000"] },
          "workingDirectory": "/home/example/projects/myapp/api",
          "environment": { "DATABASE_URL": { "value": "postgresql://postgres:change-me-before-use@127.0.0.1:5432/myapp", "secret": true } },
          "autostart": true,
          "restart": { "mode": "on-failure", "delaySeconds": 1, "maxAttempts": 5, "resetAfterSeconds": 60 },
          "stopSignal": "SIGTERM",
          "gracefulStopSeconds": 10,
          "dependencies": [{ "serviceId": "22222222-2222-4222-8222-222222222222", "condition": "healthy" }],
          "url": "http://api.myapp.localhost:8088",
          "health": { "type": "http", "intervalSeconds": 5, "timeoutSeconds": 2, "retries": 3, "startGraceSeconds": 3, "http": { "url": "http://127.0.0.1:8000/health", "expectedStatus": 200 } },
          "route": { "hostname": "api.myapp.localhost", "targetPort": 8000, "https": false }
        },
        {
          "id": "44444444-4444-4444-8444-444444444444",
          "name": "Frontend",
          "description": "Vite development server",
          "command": { "executable": "/usr/bin/npm", "arguments": ["run", "dev", "--", "--host", "127.0.0.1", "--port", "5173"] },
          "workingDirectory": "/home/example/projects/myapp/frontend",
          "environment": {},
          "autostart": true,
          "restart": { "mode": "on-failure", "delaySeconds": 1, "maxAttempts": 5, "resetAfterSeconds": 60 },
          "stopSignal": "SIGTERM",
          "gracefulStopSeconds": 10,
          "dependencies": [{ "serviceId": "33333333-3333-4333-8333-333333333333", "condition": "healthy" }],
          "url": "http://frontend.myapp.localhost:8088",
          "health": { "type": "http", "intervalSeconds": 5, "timeoutSeconds": 2, "retries": 3, "startGraceSeconds": 3, "http": { "url": "http://127.0.0.1:5173/", "expectedStatus": 200 } },
          "route": { "hostname": "frontend.myapp.localhost", "targetPort": 5173, "https": false }
        },
        {
          "id": "55555555-5555-4555-8555-555555555555",
          "name": "Worker",
          "description": "Background jobs",
          "command": { "executable": "/usr/bin/python", "arguments": ["-m", "app.worker"] },
          "workingDirectory": "/home/example/projects/myapp/api",
          "environment": { "DATABASE_URL": { "value": "postgresql://postgres:change-me-before-use@127.0.0.1:5432/myapp", "secret": true } },
          "autostart": false,
          "restart": { "mode": "always", "delaySeconds": 2, "maxAttempts": 0, "resetAfterSeconds": 60 },
          "stopSignal": "SIGTERM",
          "gracefulStopSeconds": 15,
          "dependencies": [{ "serviceId": "22222222-2222-4222-8222-222222222222", "condition": "healthy" }],
          "notes": "Worker logs are included in the MyApp combined log view."
        }
      ]
    }
  ]
}
